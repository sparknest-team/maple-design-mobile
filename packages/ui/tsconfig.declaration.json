{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noCheck": true,
    "rootDir": "src",
    "outDir": "types-generated",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true
  },
  "include": ["shims/build-styles.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/**", "src/**/example/**", "src/**/__demos__/**"]
}
