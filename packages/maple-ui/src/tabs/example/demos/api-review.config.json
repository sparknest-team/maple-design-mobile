      "type": "'automatic' | 'manual'",
      "defaultValue": "'automatic'",
      "kind": "enum",
      "options": [
        "automatic",
        "manual"
      ],
      "initial": "automatic"
    },
    {
      "name": "swipeable",
      "description": "内容横向触摸切换；不循环",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
