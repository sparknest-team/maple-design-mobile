{
  "name": "@maple-design/ui-vue",
  "version": "1.4.11",
  "description": "A Vue3 component library based on semantic tokens and brand themes, supporting mobile and desktop.",
  "keywords": [
    "Vue3",
    "Mobile",
    "Material Design",
    "UI",
    "Components"
  ],
  "homepage": "https://maplejs.org",
  "bugs": {
    "url": "https://github.com/sparknest-team/maple-design-mobile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparknest-team/maple-design-mobile.git",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "author": "shuai.meng",
  "sideEffects": [
    "src/**/style/*",
    "es/**/style/*",
    "lib/**/style/*",
    "es/style.mjs",
    "lib/style.js",
    "*.css",
    "*.less"
  ],
  "exports": {
    "./trigger/server": {
      "browser": "./trigger-server-browser.mjs",
      "default": "./trigger-server.cjs"
    },
    ".": {
      "types": "./types-generated/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.js"
    },
    "./style": {
      "types": "./reset/index.d.ts",
      "default": "./es/maple.css"
    },
    "./reset.css": {
      "types": "./reset/index.d.ts",
      "default": "./reset/index.css"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./types-generated/*/index.d.ts",
      "import": "./es/*/index.mjs",
      "require": "./lib/*/index.js"
    },
    "./*/style": {
      "import": "./es/*/style/index.mjs",
      "require": "./lib/*/style/index.js"
    },
    "./json/*": "./json/*",
    "./highlight/*": "./highlight/*"
  },
  "main": "lib/index.js",
  "jsdelivr": "umd/maple.js",
  "unpkg": "umd/maple.js",
  "module": "es/index.mjs",
  "browser": {
    "vue/server-renderer": "./ssr-browser.mjs"
  },
  "typings": "types-generated/index.d.ts",
  "style": "es/maple.css",
  "files": [
    "trigger-server.cjs",
    "trigger-server.mjs",
    "trigger-server-browser.mjs",
    "ssr-browser.mjs",
    "reset",
    "json",
    "lib",
    "es",
    "umd",
    "highlight",
    "types",
    "types-generated"
  ],
  "scripts": {
    "build": "pnpm build:lib && pnpm build:doc",
    "build:doc": "node --max-old-space-size=6144 ./node_modules/vuepress/bin/vuepress.js build docs --dest site",
    "build:lib": "maple-cli compile ui-build.config.mjs",
    "compile:style-vars": "maple-cli compile:style-vars",
    "create": "maple-cli create -i",
    "dev": "vuepress dev docs",
    "docs:llms": "ui-docs-llms maple . public",
    "preview": "maple-cli preview",
    "test": "maple-cli test",
    "test:coverage": "maple-cli test --coverage",
    "test:watch": "maple-cli test -w -cov",
    "typecheck": "tsc --runExternalCode -p tsconfig.release-check.json",
    "typecheck:contracts": "tsc --runExternalCode -p tsconfig.contracts.json"
  },
  "dependencies": {
    "@maple-design/icons-vue": "workspace:*",
    "@maple-design/shared-vue": "workspace:*",
    "@maple-design/use-vue": "workspace:*",
    "csstype": "^3.2.4",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "parse5": "^8.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@maple-design/cli-vue": "workspace:*",
    "@maple-design/touch-emulator-vue": "workspace:*",
    "@maple-design/vite-plugins-vue": "workspace:*",
    "@mdit-vue/shared": "^4.0.0",
    "@sparknest/ui-doc-preview-vue": "^1.4.4",
    "@sparknest/vuepress-plugins-vue": "^1.0.0",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vue/content-mapper": "4.0.0-alpha.0",
    "@vue/runtime-core": "catalog:",
    "@vue/server-renderer": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vuepress/bundler-vite": "2.0.0-rc.32",
    "@vuepress/plugin-prismjs": "2.0.0-rc.139",
    "clipboard": "^2.0.11",
    "jsdom": "catalog:",
    "live-server": "catalog:",
    "posthtml-parser": "^0.13.0",
    "posthtml-render": "^3.0.0",
    "prismjs": "1.30.0",
    "sass-embedded": "^1.108.2",
    "shiki": "^4.6.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "5.5.1",
    "vuepress": "2.0.0-rc.32",
    "vuepress-theme-hope": "2.0.0-rc.111"
  },
  "peerDependencies": {
    "vue": "3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "web-types": "highlight/web-types.en-US.json"
}
