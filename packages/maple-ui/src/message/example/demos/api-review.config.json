{
  "fields": [
    {
      "name": "id",
      "description": "队列内唯一标识",
      "type": "string | number",
      "defaultValue": "自动生成",
      "kind": "scalar"
    },
    {
      "name": "status",
      "description": "语义状态",
      "type": "\"default\" | \"info\" | \"success\" | \"warning\" | \"danger\" | \"loading\"",
      "defaultValue": "'default'",
      "kind": "enum",
      "options": [
        "default",
        "info",
        "success",
        "warning",
        "danger",
        "loading"
      ],
      "initial": "default"
    },
    {
      "name": "variant",
      "description": "视觉强调层级",
      "type": "\"neutral\" | \"tonal\" | \"solid\"",
      "defaultValue": "'neutral'",
      "kind": "enum",
      "options": [
        "neutral",
        "tonal",
        "solid"
      ],
      "initial": "neutral"
    },
    {
      "name": "position",
      "description": "显示位置",
      "type": "\"top\" | \"center\" | \"bottom\"",
      "defaultValue": "'top'",
      "kind": "enum",
      "options": [
        "top",
        "center",
        "bottom"
      ],
      "initial": "top"
