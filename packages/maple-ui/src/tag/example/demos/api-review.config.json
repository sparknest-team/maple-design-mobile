      "type": "string",
      "defaultValue": "undefined",
      "kind": "string",
      "initial": "#5268cc"
    },
    {
      "name": "text-color",
      "description": "自定义文字色",
      "type": "string",
      "defaultValue": "undefined",
      "kind": "string",
      "initial": "#5268cc"
    }
