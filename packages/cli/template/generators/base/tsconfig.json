{
  "contentMappers": [{ "package": "@vue/content-mapper", "extensions": [".vue"] }],
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "lib": [
      "esnext",
      "dom"
    ],
    "allowSyntheticDefaultImports": true,
    "jsxImportSource": "vue",
    "jsx": "preserve",
    "types": [
      "vitest/globals",
      "vite/client"
    ],
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ]
}
