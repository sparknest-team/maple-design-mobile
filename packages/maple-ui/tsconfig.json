{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@maplejs/maple-ui": ["./src/index.ts"],
      "@ui-foundation/ui-doc-preview": ["../../../design-ui/packages/ui-doc-preview/src/index.ts"],
      "vue": ["./node_modules/vue"]
    },
    "allowSyntheticDefaultImports": true,
    "jsxImportSource": "vue",
    "jsx": "preserve",
    "isolatedModules": true,
    "allowJs": true,
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
