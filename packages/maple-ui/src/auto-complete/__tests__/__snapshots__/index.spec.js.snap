// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`auto-complete custom color 1`] = `
"<div class="mp-auto-complete" tabindex="0">
  <div class="mp-popover mp--box mp-menu mp-auto-complete__menu" tabindex="-1" auto-complete-cover="">
    <div class="mp-input mp--box">
      <div class="mp-field-decorator mp--box mp-field-decorator--standard">
        <div class="mp-field-decorator__controller" style="color: green; cursor: text; overflow: hidden; --mp-field-decorator-middle-offset-left: 0px; --mp-field-decorator-middle-offset-width: 0px; --mp-field-decorator-middle-offset-height: 0px;">
          <div class="mp-field-decorator__icon"></div>
          <div class="mp-field-decorator__middle">
            <!--v-if--><input id="mp-input-mock-id" class="mp-input__input" autocomplete="off" type="text" style="color: red; caret-color: blue;">
          </div>
          <!--v-if-->
          <div class="mp-field-decorator__icon">
            <!--v-if-->
          </div>
        </div>
        <!--v-if-->
        <div class="mp-field-decorator__line" style="background: green;">
          <div class="mp-field-decorator__dot" style="background: blue;"></div>
        </div>
      </div>
      <!--v-if-->
    </div>
    <!--teleport start-->
    <!--teleport end-->
  </div>
</div>"
`;

