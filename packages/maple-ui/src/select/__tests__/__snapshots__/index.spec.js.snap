exports[`select focus & blur methods 1`] = `
"<div class="mp-select" tabindex="0">
  <div class="mp-field-decorator mp--box mp-field-decorator--standard">
    <div class="mp-field-decorator__controller mp-field-decorator--focus" style="cursor: pointer; overflow: visible; --mp-field-middle-offset-left: 0px; --mp-field-middle-offset-width: 0px; --mp-field-middle-offset-height: 0px;">
      <div class="mp-field-decorator__icon"></div>
      <div class="mp-field-decorator__middle">
        <div class="mp-select__select" style="text-align: left;">
          <div class="mp-select__label">
            <!--v-if-->
          </div>
          <!--v-if--><span class="mp-icon mp-select__arrow" style="transition-duration: 300ms;" mp-select-cover=""><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="mp-svg-icon" style="width: 1em; height: 1em; flex-shrink: 0;" fill="currentColor" aria-hidden="true" role="img"><!--v-if--><path d="m7 10 5 5 5-5z"></path></svg></span>
        </div>
      </div>
      <!--v-if-->
      <div class="mp-field-decorator__icon">
        <!--v-if-->
      </div>
    </div>
    <!--v-if-->
    <div class="mp-field-decorator__line">
      <div class="mp-field-decorator__dot mp-field-decorator--line-focus"></div>
    </div>
  </div>
  <!--teleport start-->
  <!--teleport end-->
</div>"
`;

