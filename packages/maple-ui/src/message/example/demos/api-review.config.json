      "defaultValue": "3000",
      "kind": "number"
    },
    {
      "name": "show-icon",
      "description": "是否显示状态图标",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "closable",
      "description": "是否显示关闭按钮",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
