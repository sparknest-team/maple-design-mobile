// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`basic mode > disabled prop 1`] = `
"<div class="mp-pagination mp-pagination--disabled">
  <!--v-if-->
  <ul class="mp-pagination__list">
    <li class="mp-pagination__item mp-pagination__prev mp-pagination__item--disabled mp-elevation--2"><i class="mp-icon mp-icon--set mp-icon-chevron-left" style="transition-duration: 0ms;"></i></li>
    <!--v-if-->
    <li class="mp-pagination__item mp-pagination__next mp-pagination__item--disabled mp-elevation--2"><i class="mp-icon mp-icon--set mp-icon-chevron-right" style="transition-duration: 0ms;"></i></li>
  </ul>
  <!--v-if-->
  <!--v-if-->
</div>"
`;

exports[`basic mode > mount 1`] = `
"<div class="mp-pagination"><span class="mp-pagination__total">共 123 条</span>
  <ul class="mp-pagination__list">
    <li class="mp-pagination__item mp-pagination__prev mp-pagination__item--disabled mp-elevation--2"><i class="mp-icon mp-icon--set mp-icon-chevron-left" style="transition-duration: 0ms;"></i></li>
    <li class="mp-pagination__item mp-elevation--2 mp-pagination__item--active">1</li>
    <li class="mp-pagination__item mp-elevation--2">2</li>
    <li class="mp-pagination__item mp-elevation--2">3</li>
    <li class="mp-pagination__item mp-elevation--2">4</li>
    <li class="mp-pagination__item mp-elevation--2">5</li>
    <li class="mp-pagination__item mp-pagination__item-ellipsis mp-elevation--2"><i class="mp-icon mp-icon--set mp-icon-dots-horizontal" style="transition-duration: 0ms;"></i></li>
    <li class="mp-pagination__item mp-elevation--2">13</li>
    <!--v-if-->
    <li class="mp-pagination__item mp-pagination__next mp-elevation--2"><i class="mp-icon mp-icon--set mp-icon-chevron-right" style="transition-duration: 0ms;"></i></li>
  </ul>
  <!--v-if--><span class="mp-pagination__jumper mp-pagination__quickly"><span class="mp-pagination__jumper-prepend">前往</span>
  <div class="mp-input mp--box" mp-pagination-cover="">
    <div class="mp-field-decorator mp--box mp-field-decorator--standard">
      <div class="mp-field-decorator__controller" style="cursor: text; overflow: hidden; --mp-field-decorator-middle-offset-left: 0px; --mp-field-decorator-middle-offset-width: 0px; --mp-field-decorator-middle-offset-height: 0px;">
        <div class="mp-field-decorator__icon mp-field-decorator--icon-non-hint"></div>
        <div class="mp-field-decorator__middle mp-field-decorator--middle-non-hint">
          <!--v-if--><input id="mp-input-mock-id" class="mp-input__input" autocomplete="new-password" type="text" style="--mp-input-placeholder-color: var(--mp-field-decorator-placeholder-color, var(--mp-field-decorator-blur-color));" value="">
        </div>
        <!--v-if-->
        <div class="mp-field-decorator__icon mp-field-decorator--icon-non-hint">
          <!--v-if-->
        </div>
      </div>
      <div class="mp-field-decorator__line">
        <div class="mp-field-decorator__dot"></div>
      </div>
    </div>
    <!--v-if-->
  </div>
  <!--v-if-->
  <!--v-if--></span>
</div>"
`;

