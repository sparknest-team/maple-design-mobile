{
  "name": "@maple-design/preset-tailwindcss-vue",
  "version": "1.4.11",
  "description": "tailwindcss preset of maple",
  "keywords": [
    "tailwindcss",
    "preset",
    "maple"
  ],
  "bugs": {
    "url": "https://github.com/sparknest-team/maple-design-mobile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparknest-team/maple-design-mobile.git",
    "directory": "packages/preset-tailwindcss"
  },
  "license": "MIT",
  "author": "chouchouji <1305974212@qq.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./*": "./*"
  },
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsdown --config ../../scripts/tsdown.config.mjs --format esm --format cjs",
    "dev": "tsdown --config ../../scripts/tsdown.config.mjs --format esm --watch"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tailwindcss": "^4.3.5",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.1 || ^4.3.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
