    {
      "name": "content",
      "description": "内容",
      "type": "MessageContent",
      "defaultValue": "undefined",
      "kind": "node",
      "initial": "审查内容 / Review content"
    },
    {
      "name": "icon",
      "description": "自定义图标",
      "type": "MessageContent",
      "defaultValue": "undefined",
      "kind": "node",
      "initial": "审查内容 / Review content"
    },
    {
