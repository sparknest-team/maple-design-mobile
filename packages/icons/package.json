{
  "name": "@maple-design/icons-vue",
  "version": "1.4.8",
  "description": "Tree-shakable SVG icon components for Maple",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparknest-team/maple-design-mobile.git",
    "directory": "packages/icons"
  },
  "license": "MIT",
  "sideEffects": [
    "./style.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./es/index.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./types/*/index.d.ts",
        "default": "./es/*/index.mjs"
      },
      "require": {
        "types": "./types/*/index.d.cts",
        "default": "./lib/*/index.cjs"
      }
    },
    "./style.css": "./style.css"
  },
  "main": "./lib/index.cjs",
  "module": "./es/index.mjs",
  "types": "./types/index.d.ts",
  "typesVersions": {
    "*": {
      "icon-*": [
        "types/icon-*/index.d.ts"
      ]
    }
  },
  "files": [
    "es",
    "lib",
    "types",
    "style.css"
  ],
  "scripts": {
    "build": "pnpm generate:check && node scripts/build.mjs",
    "dev": "node scripts/watch.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.contract.json"
  },
  "devDependencies": {
    "@sparknest/ui-icons-vue": "^1.0.0",
    "@vitejs/plugin-vue": "catalog:",
    "chokidar": "^3.6.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "^2.1.10"
  },
  "peerDependencies": {
    "vue": "^3.2.47"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
