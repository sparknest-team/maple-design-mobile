{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@maple-design/ui-vue": ["./src/index.ts"],
      "@sparknest/ui-doc-preview-vue": ["../../../design-ui/packages/ui-doc-preview/src/index.ts"],
      "vue": ["./node_modules/vue"]
    },
    "allowSyntheticDefaultImports": true,
    "jsxImportSource": "vue",
    "jsx": "preserve",
    "isolatedModules": true,
    "allowJs": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
