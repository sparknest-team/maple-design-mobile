{
  "name": "@maple-design/preset-unocss",
  "version": "1.0.0",
  "description": "unocss preset of maple",
  "keywords": [
    "unocss",
    "preset",
    "maple"
  ],
  "bugs": {
    "url": "https://xxx/pe.frontend/materials/maplejs/maple-design-mobile/-/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://xxx/pe.frontend/materials/maplejs/maple-design-mobile"
  },
  "license": "MIT",
  "author": "shuai.meng",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "types": "./lib/index.d.ts"
    },
    "./*": "./*"
  },
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --out-dir=lib --dts --clean",
    "dev": "tsup src/index.ts --format esm --out-dir=lib --watch --dts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "unocss": "^0.58.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
