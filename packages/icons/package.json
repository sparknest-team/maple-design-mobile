{
  "name": "@maple-design/icons-vue",
  "version": "1.1.4",
  "description": "Tree-shakable SVG icon components for Maple",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./es/index.mjs",
  "types": "./types/index.d.ts",
  "typesVersions": {
    "*": {
      "icon-*": ["types/icon-*/index.d.ts"]
    }
  },
  "sideEffects": [
    "./style.css"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./*": {
      "types": "./types/*/index.d.ts",
      "import": "./es/*/index.mjs",
      "require": "./lib/*/index.cjs"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "es",
    "lib",
    "types",
    "style.css"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "pnpm generate:check && node scripts/build.mjs",
    "dev": "node scripts/watch.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.contract.json"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@sparknest/ui-icons-vue": "^1.0.0",
    "@vitejs/plugin-vue": "catalog:",
    "chokidar": "^3.6.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "^2.1.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
