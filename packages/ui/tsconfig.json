{
  "extends": "../../tsconfig.json",
  "contentMappers": [
    {
      "package": "@vue/content-mapper",
      "extensions": [".vue"],
      "options": {
        "dataAttributes": [
          "data-*",
          "mp-action-sheet-cover",
          "mp-date-picker-header-cover",
          "mp-day-picker-cover",
          "mp-dialog-cover",
          "mp-month-picker-cover",
          "mp-picker-cover",
          "mp-tab-bar-item-cover",
          "mp-tab-bar__fab",
          "mp-year-picker-cover",
          "mp-date-picker-color-cover"
        ],
        "fallthroughAttributes": true
      }
    }
  ],
  "compilerOptions": {
    "paths": {
      "@maple-design/ui-vue/trigger/server": ["./src/trigger/server-module.d.ts"],
      "@maple-design/ui-vue": ["./src/index.ts"],
      "vue": ["./node_modules/vue"]
    },
    "allowSyntheticDefaultImports": true,
    "jsxImportSource": "vue",
    "jsx": "preserve",
    "isolatedModules": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "node"]
  },
  "include": ["shims/build-styles.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
