      "defaultValue": "-",
      "kind": "callback"
    },
    {
      "name": "on-opened",
      "description": "动作面板开启动画结束回调",
      "type": "() => void",
      "defaultValue": "-",
      "kind": "callback"
    },
    {
      "name": "on-close",
      "description": "动作面板关闭回调",
      "type": "() => void",
      "defaultValue": "-",
      "kind": "callback"
    },
    {
      "name": "on-closed",
      "description": "动作面板关闭动画结束回调",
      "type": "() => void",
      "defaultValue": "-",
      "kind": "callback"
    },
    {
