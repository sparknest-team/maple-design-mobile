{
  "version": "1.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install && node scripts/bootstrap.mjs",
    "build": "pnpm build:lib && pnpm build:doc",
    "build:doc": "pnpm --filter @maple-design/vite-plugins-vue build && pnpm --filter @maple-design/cli-vue build:node && pnpm --dir ./packages/ui build:doc",
    "docs:check": "node scripts/quality/demo-sfc-check.mjs",
    "check:doc-pipeline": "node --test ../design-ui/bin/public-documentation-policy.test.mjs ../design-ui/bin/component-css-docs.test.mjs && node ../design-ui/bin/public-docs-check.mjs && node --test ../design-ui/bin/clean-public-component-docs.test.mjs ../design-ui/bin/normalize-api-headings.test.mjs ../design-ui/bin/api-document-structure.test.mjs ../design-ui/bin/llms-docs.test.mjs ../design-ui/bin/group-demo-sections.test.mjs ../design-ui/bin/group-maple-examples.test.mjs ../design-ui/bin/compose-demo-comparison.test.mjs ../design-ui/bin/demo-config-comparison.test.mjs ../design-ui/bin/demo-content-parity.test.mjs ../design-ui/bin/api-documentation-locales.test.mjs && node --test scripts/quality/site-resolver.test.mjs scripts/quality/markdown-demo-syntax.test.mjs scripts/quality/demo-language-route.test.mjs",
    "build:lib": "node scripts/build-lib.mjs",
    "build:play": "pnpm --dir ./packages/ui-playground build",
    "changelog": "maple-cli changelog",
    "changeset": "changeset",
    "clean": "rimraf ./node_modules ./packages/*/node_modules",
    "compile:style-vars": "pnpm --dir ./packages/ui compile:style-vars",
    "create": "pnpm --dir ./packages/ui run create",
    "dev": "pnpm --dir ./packages/ui dev",
    "dev:play": "pnpm --dir ./packages/ui-playground dev",
    "format": "prettier --write .",
    "format:cache": "prettier --write --cache .",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "lint": "eslint --fix . && pnpm check:api-naming",
    "lint:cache": "eslint --fix --cache .",
    "lint:check": "eslint . --max-warnings 0 && pnpm check:api-naming",
    "package:check": "node scripts/quality/package-check.mjs && node scripts/quality/native-entry-check.mjs",
    "preview": "pnpm --dir ./packages/ui preview",
    "preview:play": "pnpm --dir ./packages/ui-playground preview",
    "quality": "pnpm check:packages && pnpm check:runtime-dependencies && pnpm check:shared && pnpm build:lib && pnpm spec:check && pnpm check:style-vars && pnpm check:dev-boundary && pnpm check:cross-platform && pnpm lint:check && pnpm typecheck && pnpm typecheck:playground && pnpm check:test-collection && pnpm test && pnpm check:direction && pnpm check:cli && pnpm check:doc-pipeline && pnpm check:source-normalization && pnpm check:icon-bundle && pnpm check:component-bundle && pnpm build:doc && pnpm package:check && pnpm check:published-environment && pnpm check:docs-theme && pnpm check:docs-components && pnpm check:safe-area && pnpm check:brand-form && pnpm check:compatibility",
    "check:published-environment": "node ../design-ui/bin/published-environment-check.mjs",
    "check:docs-components": "node --test scripts/browser/components.test.mjs",
    "check:runtime-dependencies": "node scripts/quality/runtime-dependency-check.mjs",
    "check:shared": "node --test scripts/quality/shared-bundle.test.mjs",
    "release": "node scripts/release.mjs",
    "release:extension": "pnpm --dir ./packages/vscode-extension release",
    "spec:check": "node scripts/quality/spec-check.mjs",
    "test": "pnpm --dir ./packages/ui test",
    "test:coverage": "pnpm --dir ./packages/ui test:coverage",
    "test:watch": "pnpm --dir ./packages/ui test:watch",
    "typecheck": "pnpm --dir ./packages/ui exec vue-tsc --noEmit -p tsconfig.json && pnpm --dir packages/ui exec vue-tsc --noEmit -p tsconfig.p1-api.json",
    "version-packages": "changeset version",
    "check:tabs": "node checks/tabs-same-source.mjs",
    "check:rate": "node checks/rate-same-source.mjs",
    "check:ripple": "node checks/ripple-same-source.mjs",
    "check:lightweight-feedback": "node checks/lightweight-feedback-same-source.mjs",
    "check:input": "node checks/input-same-source.mjs",
    "check:selection-field": "node --test ../design-ui/bin/selection-field-class-normalization.test.mjs && node checks/selection-field-same-source.mjs",
    "check:selection-presentations": "node checks/selection-presentations-same-source.mjs",
    "check:auto-complete": "node checks/auto-complete-same-source.mjs",
    "check:mention-input-tag": "node checks/mention-input-tag-same-source.mjs",
    "check:time-rules": "node checks/time-rules-same-source.mjs",
    "check:form-kernel": "node checks/form-kernel-same-source.mjs",
    "check:style-vars": "node checks/style-vars-contract.mjs && node --test ../design-ui/bin/css-variable-consumers.test.mjs && node ../design-ui/bin/component-css-docs.mjs --check",
    "check:date-family": "node checks/date-family-same-source.mjs",
    "check:scroll-text": "node checks/scroll-text-same-source.mjs",
    "check:dev-boundary": "node --test scripts/quality/dev-publish-boundary.test.mjs",
    "check:cli": "node --test scripts/quality/project-templates.test.mjs scripts/quality/docs-cache.test.mjs scripts/quality/cli-bin.test.mjs scripts/quality/cli-bootstrap-types.test.mjs scripts/quality/nav-menu-entry.test.mjs && pnpm --dir packages/cli test",
    "check:source-normalization": "node --test scripts/quality/source-normalization.test.mjs",
    "check:test-collection": "node --test scripts/quality/test-collection-boundary.test.mjs",
    "check:cross-platform": "pnpm check:tabs && pnpm check:rate && pnpm check:ripple && pnpm check:lightweight-feedback && pnpm check:input && pnpm check:selection-field && pnpm check:selection-presentations && pnpm check:auto-complete && pnpm check:mention-input-tag && pnpm check:time-rules && pnpm check:form-kernel && pnpm check:date-family && pnpm check:scroll-text",
    "check:icon-bundle": "node --test scripts/quality/icon-bundle.test.mjs scripts/quality/icon-types.test.mjs",
    "check:component-bundle": "node scripts/quality/component-bundle.cjs && node --test scripts/quality/shared-bundle.test.mjs scripts/quality/aggregate-install-bundle.test.mjs",
    "check:docs-theme": "node --test scripts/browser/docs-theme.test.mjs",
    "check:safe-area": "node --test scripts/browser/safe-area.test.mjs",
    "check:brand-form": "node --test --test-concurrency=1 scripts/browser/brand-form.test.mjs scripts/browser/brand-docs.test.mjs",
    "check:api-naming": "node ../design-ui/bin/api-naming-check.mjs",
    "check:compatibility": "node ../design-ui/browser/matrix.mjs maple",
    "compatibility:native:init": "node ../design-ui/browser/native-acceptance.mjs maple --init",
    "check:compatibility:release": "node ../design-ui/browser/native-acceptance.mjs maple",
    "check:direction": "pnpm --dir packages/ui exec vitest run --config reading-direction.vitest.config.mjs src/_utils/__tests__/reading-direction.spec.js src/steps/__tests__/reading-direction.spec.js src/nav-menu/__tests__/reading-direction.spec.js src/table/__tests__/reading-direction.spec.js src/_components/virtual-list-v2/__tests__/reading-direction.spec.js --maxWorkers=1 --minWorkers=1 src/field-decorator/__tests__/reading-direction.spec.js src/form/__tests__/reading-direction.spec.ts src/radio/__tests__/reading-direction.spec.js src/cascader/__tests__/reading-direction.spec.ts src/auto-complete/__tests__/reading-direction.spec.ts src/date/__tests__/reading-direction.spec.ts src/time/__tests__/reading-direction.spec.ts src/time-range/__tests__/reading-direction.spec.ts src/button/__tests__/reading-direction.spec.ts src/split-button/__tests__/reading-direction.spec.ts src/space/__tests__/reading-direction.spec.ts src/divider/__tests__/reading-direction.spec.ts",
    "check:packages": "node --test scripts/quality/package-boundary-check.test.mjs && node scripts/quality/package-boundary-check.mjs",
    "typecheck:playground": "pnpm --dir packages/ui exec vue-tsc --noEmit -p ../ui-playground/tsconfig.json"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged --allow-empty",
    "commit-msg": "pnpm exec maple-cli commit-lint -p $1 && pnpm exec maple-cli checklist $1"
  },
  "nano-staged": {
    "*.{ts,tsx,js,vue,less}": "prettier --write",
    "*.{ts,tsx,js,vue}": "eslint --fix"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@configurajs/eslint": "^0.1.2",
    "@configurajs/prettier": "^0.1.4",
    "@maple-design/icons-vue": "workspace:*",
    "@maple-design/cli-vue": "workspace:*",
    "@sparknest/theme-contract-vue": "link:../design-ui/packages/theme-contract",
    "@vue/server-renderer": "catalog:",
    "axe-core": "^4.10.3",
    "eslint": "^9.32.0",
    "nano-staged": "0.8.0",
    "nanospinner": "^1.2.2",
    "playwright": "1.62.0",
    "prettier": "^3.6.2",
    "rimraf": "catalog:",
    "simple-git-hooks": "^2.13.1",
    "tinyexec": "npm:tinyexec@^0.3.0",
    "typescript": "catalog:",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "pnpm": ">=9.6.0"
  },
  "pnpm": {
    "overrides": {
      "array-includes": "npm:@nolyfill/array-includes@latest",
      "array.prototype.flat": "npm:@nolyfill/array.prototype.flat@latest",
      "array.prototype.flatmap": "npm:@nolyfill/array.prototype.flatmap@latest",
      "object.assign": "npm:@nolyfill/object.assign@latest",
      "object.entries": "npm:@nolyfill/object.entries@latest",
      "object.values": "npm:@nolyfill/object.values@latest",
      "tinyexec": "npm:tinyexec@^0.3.0",
      "@sparknest/ui-build-vue": "link:../design-ui/packages/ui-build",
      "@sparknest/ui-doc-preview-vue": "link:../design-ui/packages/ui-doc-preview",
      "@sparknest/ui-icons-vue": "link:../design-ui/packages/ui-icons",
      "@sparknest/theme-contract-vue": "link:../design-ui/packages/theme-contract"
    }
  },
  "name": "@maple-design/workspace-vue"
}
