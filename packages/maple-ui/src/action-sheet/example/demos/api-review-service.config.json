{
  "fields": [
    {
      "name": "open",
      "description": "是否显示动作面板",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "actions",
      "description": "选项列表",
      "type": "Actions",
      "defaultValue": "() => []",
      "kind": "json",
      "initial": "[{\"name\":\"Review action\",\"icon\":\"check\",\"disabled\":false}]"
    },
    {
      "name": "title",
      "description": "动作面板标题",
      "type": "string",
      "defaultValue": "undefined",
      "kind": "string"
    },
    {
      "name": "overlay",
      "description": "是否显示背景层",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "overlay-class",
      "description": "自定义背景层的 class",
      "type": "string",
      "defaultValue": "-",
      "kind": "string"
    },
    {
      "name": "overlay-style",
      "description": "自定义背景层的 style",
