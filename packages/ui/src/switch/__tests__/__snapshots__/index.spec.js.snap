// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders the common contract 1`] = `"<button type="button" role="switch" class="mp-switch mp-switch--variant-circle mp-switch--size-md" aria-checked="false"><span class="mp-switch__track" aria-hidden="true"></span><span class="mp-switch__text"></span><span class="mp-switch__handle" style="box-shadow: 0 1px 3px var(--mp-switch-shadow-color);"><!--v-if--></span></button>"`;
