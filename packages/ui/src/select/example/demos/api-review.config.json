      ]
    },
    {
      "name": "field-names",
      "kind": "prop",
      "demos": [
        "async-devices.vue",
        "dialog.vue",
        "appearance-lab.vue",
        "standard.vue"
      ]
    },
    {
      "name": "filterable",
      "kind": "prop",
      "demos": [
        "async-devices.vue"
      ]
    },
    {
      "name": "filter-option",
      "kind": "prop",
      "demos": []
    },
    {
      "name": "fallback-option",
      "kind": "prop",
      "demos": []
    },
    {
      "name": "scrollbar",
      "kind": "prop",
      "demos": [
        "scrollbar-lifecycle.vue",
        "thumb-lifecycle.vue"
      ]
    },
    {
      "name": "before-commit",
      "kind": "prop",
      "demos": []
    },
    {
      "name": "model-value",
      "kind": "prop",
      "demos": []
    },
    {
      "name": "default-value",
      "kind": "prop",
      "demos": []
    }
  ],
  "slotNames": [
    "option",
    "label",
    "selected",
    "header",
    "footer",
    "trigger",
    "prefix",
    "suffix",
    "clear-icon",
    "arrow-icon",
    "search-icon",
    "loading-icon",
    "empty",
    "read"
  ],
  "slotDefaults": {
    "option": false,
    "label": false,
    "selected": false,
    "header": false,
    "footer": false,
    "trigger": false,
    "prefix": false,
    "suffix": false,
    "clear-icon": false,
    "arrow-icon": false,
    "search-icon": false,
    "loading-icon": false,
    "empty": false,
    "read": false
  },
  "methodNames": [
    "focus",
    "blur"
  ]
}
