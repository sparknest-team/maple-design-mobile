{
  "fields": [
    {
      "name": "model-value",
      "description": "当前选中 name；提供时受控",
      "type": "string / number",
      "defaultValue": "undefined",
      "kind": "scalar"
    },
    {
      "name": "default-value",
      "description": "非受控初值，省略选首个可用项",
      "type": "string / number",
      "defaultValue": "undefined",
      "kind": "scalar"
    },
    {
      "name": "variant",
      "description": "视觉变体",
      "type": "'line' | 'card' | 'outline' | 'plain' | 'capsule' | 'enclosed'",
      "defaultValue": "'line'",
      "kind": "enum",
      "options": [
        "line",
        "card",
        "outline",
        "plain",
        "capsule",
        "enclosed"
      ],
      "initial": "line"
    },
    {
      "name": "size",
      "description": "尺寸",
      "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
      "defaultValue": "undefined",
      "kind": "enum",
      "options": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ],
      "initial": "xs"
    },
    {
      "name": "orientation",
      "description": "导航方向",
      "type": "\"horizontal\" | \"vertical\"",
