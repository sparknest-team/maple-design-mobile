// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`breadcrumb basic usage 1`] = `
"<div class="mp-breadcrumb" role="navigation" aria-label="Breadcrumb">
  <div class="mp-breadcrumb-item" role="listitem">
    <div class="mp-breadcrumb-item__content mp-breadcrumb-item--active">HOME</div>
    <div class="mp-breadcrumb-item__separator" aria-hidden="true">/</div>
  </div>
  <div class="mp-breadcrumb-item" role="listitem">
    <div class="mp-breadcrumb-item__content mp-breadcrumb-item--active">LINK 1</div>
    <div class="mp-breadcrumb-item__separator" aria-hidden="true">/</div>
  </div>
  <div class="mp-breadcrumb-item" role="listitem">
    <div class="mp-breadcrumb-item__content">LINK 2</div>
    <!--v-if-->
  </div>
</div>"
`;

