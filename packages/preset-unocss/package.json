{
  "name": "@maple-design/preset-unocss-vue",
  "version": "1.4.9",
  "description": "unocss preset of maple",
  "keywords": [
    "unocss",
    "preset",
    "maple"
  ],
  "bugs": {
    "url": "https://github.com/sparknest-team/maple-design-mobile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparknest-team/maple-design-mobile.git",
    "directory": "packages/preset-unocss"
  },
  "license": "MIT",
  "author": "shuai.meng",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./*": "./*"
  },
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsdown --config ../../scripts/tsdown.config.mjs --format esm --format cjs",
    "dev": "tsdown --config ../../scripts/tsdown.config.mjs --format esm --watch"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
