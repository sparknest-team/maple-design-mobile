{
  "name": "@maple-design/use-vue",
  "version": "1.4.1",
  "description": "composable utils of maple",
  "keywords": [
    "composable",
    "utils",
    "maple"
  ],
  "bugs": {
    "url": "https://github.com/sparknest-team/maple-design-mobile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparknest-team/maple-design-mobile.git",
    "directory": "packages/use"
  },
  "license": "MIT",
  "author": "shuai.meng",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "types": "./lib/index.d.ts"
    }
  },
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --out-dir=lib --dts --clean && node ../../../design-ui/bin/vue-compat-declarations.mjs lib",
    "dev": "tsup src/index.ts --format esm --out-dir=lib --watch --dts"
  },
  "dependencies": {
    "@maple-design/shared-vue": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.2.47"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
