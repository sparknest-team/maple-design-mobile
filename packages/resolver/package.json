{
  "name": "@maple-design/resolver-vue",
  "version": "1.4.10",
  "description": "Maple resolver for unplugin-vue-components and unplugin-auto-import",
  "keywords": [
    "maple",
    "resolver",
    "unplugin-vue-components",
    "unplugin-auto-import"
  ],
  "bugs": {
    "url": "https://github.com/sparknest-team/maple-design-mobile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparknest-team/maple-design-mobile.git",
    "directory": "packages/resolver"
  },
  "license": "MIT",
  "author": "shuai.meng",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./*": "./*"
  },
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsdown --config ../../scripts/tsdown.config.mjs --format esm --format cjs",
    "dev": "tsdown --config ../../scripts/tsdown.config.mjs --format esm --watch",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@maple-design/icons-vue": "workspace:*",
    "@maple-design/shared-vue": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
