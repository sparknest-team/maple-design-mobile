// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`result snapshot 1`] = `
"<div class="mp-result mp--box">
  <div class="mp-result__image-container">
    <div class="mp-result__image mp-result__success" style="width: calc(var(--mp-result-image-size) * 0.9); height: calc(var(--mp-result-image-size) * 0.9); border-width: calc(var(--mp-result-image-size) * 0.05);"><span class="mp-result__success-cover-left"></span><span class="mp-result__success-line mp-result__success-line-tip" style="animation-duration: 760ms; border-radius: calc(calc(var(--mp-result-image-size) * 0.05) * 0.625);"></span><span class="mp-result__success-line mp-result__success-line-long" style="animation-duration: 770ms; border-radius: calc(calc(var(--mp-result-image-size) * 0.05) * 0.625);"></span><span class="mp-result__success-circle" style="left: -calc(var(--mp-result-image-size) * 0.05); top: -calc(var(--mp-result-image-size) * 0.05); border-width: calc(var(--mp-result-image-size) * 0.05);"></span><span class="mp-result__success-line-fix"></span><span class="mp-result__success-cover-right" style="animation-duration: 4250ms;"></span></div>
  </div>
  <!--v-if-->
  <!--v-if-->
  <!--v-if-->
</div>"
`;
