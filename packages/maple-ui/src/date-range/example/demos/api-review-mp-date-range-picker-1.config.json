      "type": "string",
      "defaultValue": "date",
      "kind": "string"
    },
    {
      "name": "day-start-of-week",
      "description": "每周第一天；仅日历展示，整数 0～6",
      "type": "0 | 1 | 2 | 3 | 4 | 5 | 6",
      "defaultValue": "0",
      "kind": "enum",
      "options": [
        "0",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ],
      "initial": "1"
    },
    {
      "name": "show-time",
      "description": "是否选择时间",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "use-seconds",
      "description": "默认时间精度，显式 format 优先",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "min",
      "description": "可选最小日期",
      "type": "DateValue",
      "defaultValue": "-",
      "kind": "json",
      "initial": "\"2026-10-21\""
    },
    {
      "name": "max",
      "description": "可选最大日期",
      "type": "DateValue",
      "defaultValue": "-",
      "kind": "json",
      "initial": "\"2026-10-21\""
    },
    {
      "name": "disabled-date",
      "description": "true 为禁用；side 为 start 或 end",
