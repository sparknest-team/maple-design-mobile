{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "contentMappers": [{ "package": "@vue/content-mapper", "extensions": [".vue"] }],
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
