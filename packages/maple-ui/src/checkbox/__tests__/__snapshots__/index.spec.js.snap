      </div>
    </div>
    <div class="mp-checkbox__wrap">
      <div class="mp-checkbox">
        <div class="mp-checkbox__action mp-checkbox--unchecked" tabindex="0">
          <!--v-if-->
          <!--v-if--><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="mp-svg-icon mp-checkbox__icon" style="width: 1em; height: 1em; flex-shrink: 0;" fill="currentColor" aria-hidden="true" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter" role="img" mp-checkbox-cover="">
            <!--v-if-->
