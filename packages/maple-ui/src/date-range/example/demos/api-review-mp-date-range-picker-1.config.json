      "defaultValue": "—",
      "kind": "callback"
    },
    {
      "name": "disabled-time",
      "description": "当前日期和端点的禁用时分秒列表",
      "type": "(date: Date, side: DateSide) => DateDisabledTime",
      "defaultValue": "—",
      "kind": "callback"
    },
    {
