{
  "fields": [
    {
      "name": "model-value",
      "description": "受控值",
      "type": "DateValue / DateValue[] (multiple/range)",
      "defaultValue": "undefined",
      "kind": "json",
      "initial": "\"2026-10-21\""
    },
    {
      "name": "default-value",
      "description": "非受控初始值，仅初始化读取",
      "type": "DateValue / DateValue[] (multiple/range)",
      "defaultValue": "undefined",
      "kind": "json",
      "initial": "\"2026-10-21\""
    },
    {
      "name": "format",
      "description": "展示格式或格式化函数",
      "type": "string / (date: Date) => string",
      "defaultValue": "—",
      "kind": "string",
      "initial": "YYYY-MM-DD"
    },
    {
      "name": "value-format",
      "description": "模型格式、Date 或 timestamp",
      "type": "string",
      "defaultValue": "—",
      "kind": "string"
    },
    {
      "name": "disable-confirm",
      "description": "选择后立即提交",
      "type": "boolean",
      "defaultValue": "字段 false；面板 true",
      "kind": "boolean"
    },
    {
      "name": "type",
      "description": "选择器类型，可选值为 date month year",
      "type": "string",
      "defaultValue": "date",
      "kind": "string"
    },
    {
      "name": "presentation",
      "description": "面板形态：calendar picker calendarPicker",
      "type": "string",
      "defaultValue": "calendarPicker",
      "kind": "string"
    },
    {
      "name": "show-time",
      "description": "是否选择时间",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "time-fields",
      "description": "时间列及顺序",
      "type": "readonly TimePickerField[]",
      "defaultValue": "['hour', 'minute', 'second']",
      "kind": "json",
      "initial": "[\"hour\",\"minute\",\"second\"]"
    },
    {
      "name": "disabled-date",
      "description": "true 为禁用；side 为 start 或 end",
      "type": "(date: Date, side: DateSide) => boolean",
      "defaultValue": "—",
      "kind": "callback"
    },
    {
      "name": "disabled-time",
      "description": "当前日期和端点的禁用时分秒列表",
      "type": "(date: Date, side: DateSide) => DateDisabledTime",
      "defaultValue": "—",
      "kind": "callback"
    },
    {
      "name": "color",
      "description": "选择器的颜色",
      "type": "string",
      "defaultValue": "-",
      "kind": "string",
      "initial": "#5268cc"
    },
    {
      "name": "title-color",
      "description": "标题背景色。如果未指定，将使用 color 属性或默认颜色。",
      "type": "string",
      "defaultValue": "-",
      "kind": "string",
      "initial": "#5268cc"
    },
    {
      "name": "hint",
      "description": "选择器提示语",
      "type": "string",
      "defaultValue": "选择日期",
      "kind": "string"
    },
    {
      "name": "elevation",
      "description": "海拔高度，可选值为 true false 和 0-24 的等级",
      "type": "number | boolean",
      "defaultValue": "false",
      "kind": "json",
      "initial": "false"
    },
    {
      "name": "button-elevation",
      "description": "Button 的海拔高度",
      "type": "string | number | boolean",
      "defaultValue": "true",
      "kind": "json",
      "initial": "false"
    },
    {
      "name": "day-start-of-week",
      "description": "设置一周的第一天，从周日的 0 开始。",
      "type": "0 | 1 | 2 | 3 | 4 | 5 | 6",
      "defaultValue": "0",
      "kind": "enum",
      "options": [
        "0",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ],
      "initial": "1"
    },
    {
      "name": "min",
      "description": "允许的最小日期/月份（ISO 8601格式）",
      "type": "DateValue",
      "defaultValue": "-",
      "kind": "json",
      "initial": "\"2026-10-21\""
    },
    {
      "name": "max",
      "description": "允许的最大日期/月份（ISO 8601格式）",
      "type": "DateValue",
      "defaultValue": "-",
      "kind": "json",
      "initial": "\"2026-10-21\""
    },
    {
      "name": "show-current",
      "description": "是否显示当前日期",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "readonly",
      "description": "是否只读",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "multiple",
      "description": "是否支持选择多个日期",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "range",
      "description": "是否支持选择一个范围",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "touchable",
      "description": "是否支持拖动切换面板",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "date-fields",
      "description": "日期滚轮列及顺序，不改变日历网格",
      "type": "readonly DatePickerField[]",
      "kind": "json",
      "defaultValue": "按 type 生成",
      "initial": "[\"year\",\"month\",\"day\"]"
    }
  ],
  "methodNames": [],
  "events": [
    "preview",
    "change",
    "select",
    "update:pickerValue",
    "picker-value-change",
    "select-shortcut"
  ],
  "slotNames": [
    "year",
    "month",
    "date",
    "range",
    "multiple",
    "actions"
  ],
  "slotDefaults": {
    "year": false,
    "month": false,
    "date": false,
    "range": false,
    "multiple": false,
    "actions": false
  },
  "scenarios": []
}
