{
  "name": "maple-vscode-extension-vue",
  "displayName": "maple-vscode-extension-vue",
  "version": "1.4.5",
  "private": true,
  "description": "maple extension for vscode",
  "categories": [
    "Other"
  ],
  "bugs": {
    "url": "https://github.com/sparknest-team/maple-design-mobile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparknest-team/maple-design-mobile.git",
    "directory": "packages/vscode-extension"
  },
  "publisher": "haoziqaq",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "maple-cli build:extension",
    "dev": "maple-cli dev:extension",
    "release": "pnpm build && vsce package --no-dependencies && vsce publish --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "maple.open-documentation",
        "title": "Maple: Open Maple UI Documentation"
      },
      {
        "command": "maple.open-playground",
        "title": "Maple: Open Maple UI Playground"
      },
      {
        "command": "maple.open-playground-by-selection",
        "title": "Maple: Open Maple UI Playground By Selection"
      },
      {
        "command": "maple.open-playground-by-selection-and-wrap-template-tag",
        "title": "Maple: Open Maple UI Playground By Selection And Wrap Template Tag"
      },
      {
        "command": "maple.open-webview",
        "title": "Maple: Open Webview"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Maple Extension Configuration",
      "properties": {
        "maple.useChineseLanguage": {
          "type": "boolean",
          "default": false,
          "description": "Use chinese language"
        },
        "maple.useVercelOrigin": {
          "type": "boolean",
          "default": false,
          "description": "Use vercel origin"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "maple.open-webview",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "maple.open-playground-by-selection",
          "group": "navigation",
          "when": "editorHasSelection"
        },
        {
          "command": "maple.open-playground-by-selection-and-wrap-template-tag",
          "group": "navigation",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "activationEvents": [
    "onLanguage:vue",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "dependencies": {
    "@maple-design/icons-vue": "workspace:*",
    "@maple-design/shared-vue": "workspace:*",
    "@maple-design/ui-vue": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "^1.102.0",
    "@maple-design/cli-vue": "workspace:*",
    "@vscode/vsce": "^3.6.0",
    "typescript": "catalog:"
  },
  "engines": {
    "vscode": "^1.56.0"
  },
  "icon": "assets/icon.png"
}
