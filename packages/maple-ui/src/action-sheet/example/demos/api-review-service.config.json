      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "esc-to-close",
      "description": "是否支持键盘 ESC 关闭动作面板",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "safe-area",
