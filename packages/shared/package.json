{
  "name": "@maple-design/shared-vue",
  "version": "1.4.11",
  "description": "shared utils of maple",
  "keywords": [
    "shared",
    "utils",
    "maple"
  ],
  "bugs": {
    "url": "https://github.com/sparknest-team/maple-design-mobile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparknest-team/maple-design-mobile.git",
    "directory": "packages/shared"
  },
  "license": "MIT",
  "author": "shuai.meng",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsdown --config ../../scripts/tsdown.config.mjs --format esm --format cjs",
    "dev": "tsdown --config ../../scripts/tsdown.config.mjs --format esm --watch",
    "test": "node --test ../../scripts/quality/shared-bundle.test.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
