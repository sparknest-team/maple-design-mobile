{
  "name": "@maplejs/icons-vue",
  "version": "1.0.3",
  "description": "Tree-shakable SVG icon components for Maple",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./es/index.mjs",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./*": {
      "types": "./types/*/index.d.ts",
      "import": "./es/*/index.mjs",
      "require": "./lib/*/index.cjs"
    }
  },
  "files": ["es", "lib", "types"],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "pnpm generate:check && node scripts/build.mjs",
    "dev": "node scripts/watch.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@loca/ui-icons": "file:../../../design-ui/packages/ui-icons",
    "@vitejs/plugin-vue": "catalog:",
    "chokidar": "^3.6.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "^2.1.10"
  }
}
