// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`counter decimalLength 1`] = `
"<div class="mp-counter mp--box">
  <div class="mp-counter__controller mp-elevation--2"><button class="mp-button mp--box mp-button--size-md mp-button--status-default mp-button--variant-default mp--inline-flex mp-elevation--2 mp-button--round mp-counter__decrement-button" type="button" mp-counter-cover="">
      <!--v-if-->
      <div class="mp-button__content"><i class="mp-icon mp-icon--set mp-icon-minus" style="transition-duration: 0ms;"></i></div>
      <div class="mp-hover-overlay"></div>
    </button><input class="mp-counter__input" inputmode="numeric"><button class="mp-button mp--box mp-button--size-md mp-button--status-default mp-button--variant-default mp--inline-flex mp-elevation--2 mp-button--round mp-counter__increment-button" type="button" mp-counter-cover="">
      <!--v-if-->
      <div class="mp-button__content"><i class="mp-icon mp-icon--set mp-icon-plus" style="transition-duration: 0ms;"></i></div>
      <div class="mp-hover-overlay"></div>
    </button></div>
</div>"
`;

