// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`safe area 1`] = `"<div data-v-app=""><!--teleport start--><!--teleport end--></div><div class="mp--box mp-popup" style="z-index: 1998;"><div class="mp-popup__overlay" style="z-index: 1999;"></div><div class="mp-popup__content mp-popup--bottom mp-popup--content-background-color mp-elevation--3 mp-popup--safe-area mp-picker__popup" style="z-index: 2000;" role="dialog" aria-modal="true" mp-picker-cover=""><div class="mp-picker"><div class="mp-picker__toolbar"><button class="mp-button mp--box mp-button--size-md mp-button--status-default mp-button--variant-default mp--inline-flex mp-elevation--2 mp-picker__cancel-button" type="button" mp-picker-cover="" text=""><!--v-if--><div class="mp-button__content">取消</div><div class="mp-hover-overlay"></div></button><div class="mp-picker__title">请选择</div><button class="mp-button mp--box mp-button--size-md mp-button--status-default mp-button--variant-default mp--inline-flex mp-elevation--2 mp-picker__confirm-button" type="button" text="" mp-picker-cover=""><!--v-if--><div class="mp-button__content">确认</div><div class="mp-hover-overlay"></div></button></div><div class="mp-picker__columns" style="height: 264px;"><div class="mp-picker__column"><div class="mp-picker__scroller" style="transform: translateY(110px); transition-duration: 0ms; transition-property: none;"><div class="mp-picker__option" style="height: 44px;"><div class="mp-picker__text">A</div></div><div class="mp-picker__option" style="height: 44px;"><div class="mp-picker__text">B</div></div><div class="mp-picker__option" style="height: 44px;"><div class="mp-picker__text">C</div></div></div></div><div class="mp-picker__picked" style="top: 110px; height: 44px;"></div><div class="mp-picker__mask" style="background-size: 100% 110px;"></div></div></div></div></div>"`;
