// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`safe area 1`] = `"<div data-v-app=""><!--teleport start--><!--teleport end--></div><div class="mp--box mp-popup" style="z-index: 1998;"><div class="mp-popup__overlay" style="z-index: 1999;" role="presentation"></div><div data-modal-focus-root="" class="mp-popup__content mp-popup--bottom mp-popup--content-background-color mp-elevation--3 mp-popup--safe-area-inset-bottom mp-picker__popup" style="z-index: 2000;" tabindex="-1" role="dialog" aria-modal="true" mp-picker-cover=""><div class="mp-picker"><div class="mp-picker__toolbar"><button class="mp-button mp-button--size-md mp-button--status-default mp-button--variant-text mp-picker__cancel-button" type="button" mp-picker-cover=""><!--v-if--><!--v-if--><span class="mp-button__content">取消</span><div class="mp-hover-overlay"></div></button><div class="mp-picker__title">请选择</div><button class="mp-button mp-button--size-md mp-button--status-default mp-button--variant-text mp-picker__confirm-button" type="button" mp-picker-cover=""><!--v-if--><!--v-if--><span class="mp-button__content">确认</span><div class="mp-hover-overlay"></div></button></div><div class="mp-picker__columns" style="height: 264px;"><div class="mp-picker__column" role="listbox" tabindex="0" aria-label="请选择 1" aria-activedescendant="v-0-0-0"><div class="mp-picker__scroller" style="transform: translateY(110px); transition-duration: 0ms; transition-property: none;"><div id="v-0-0-0" role="option" aria-selected="true" class="mp-picker__option" style="height: 44px;"><div class="mp-picker__text">A</div><!--v-if--></div><div id="v-0-0-1" role="option" aria-selected="false" class="mp-picker__option" style="height: 44px;"><div class="mp-picker__text">B</div><!--v-if--></div><div id="v-0-0-2" role="option" aria-selected="false" class="mp-picker__option" style="height: 44px;"><div class="mp-picker__text">C</div><!--v-if--></div></div></div><div class="mp-picker__picked" style="top: 110px; height: 44px;"></div><div class="mp-picker__mask" style="background-size: 100% 110px;"></div></div></div></div></div>"`;
