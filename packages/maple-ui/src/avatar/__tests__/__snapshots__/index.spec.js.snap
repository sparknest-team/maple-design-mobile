exports[`avatar group basic use 1`] = `
"<div class="mp-avatar-group mp-avatar-group--row">
  <div class="mp-avatar mp--box mp-avatar--normal mp-avatar--round">
    <div class="mp-avatar__text" style="transform: scale(1);"></div>
  </div>
  <div class="mp-avatar mp--box mp-avatar--normal mp-avatar--round">
    <div class="mp-avatar__text" style="transform: scale(1);"></div>
  </div>
  <div class="mp-avatar mp--box mp-avatar--normal mp-avatar--round">
    <div class="mp-avatar__text" style="transform: scale(1);"></div>
  </div>
</div>"
`;

