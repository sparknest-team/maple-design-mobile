{
  "fields": [
    {
      "name": "model-value",
      "description": "受控值",
      "type": "DateValue[]",
      "defaultValue": "undefined",
      "kind": "json",
      "initial": "\"2026-10-21\""
    },
    {
      "name": "default-value",
      "description": "非受控初始值，仅初始化读取",
      "type": "DateValue[]",
      "defaultValue": "undefined",
      "kind": "json",
      "initial": "\"2026-10-21\""
    },
    {
      "name": "format",
      "description": "展示格式或格式化函数",
      "type": "string / (date: Date) => string",
      "defaultValue": "—",
      "kind": "string",
      "initial": "YYYY-MM-DD"
    },
    {
      "name": "value-format",
      "description": "模型格式、Date 或 timestamp",
      "type": "string",
      "defaultValue": "—",
      "kind": "string"
    },
    {
      "name": "disable-confirm",
      "description": "选择后立即提交",
      "type": "boolean",
      "defaultValue": "字段 false；面板 true",
      "kind": "boolean"
    },
    {
      "name": "presentation",
      "description": "面板模式：calendar picker calendarPicker",
      "type": "string",
      "defaultValue": "calendarPicker",
      "kind": "string"
    },
    {
      "name": "type",
