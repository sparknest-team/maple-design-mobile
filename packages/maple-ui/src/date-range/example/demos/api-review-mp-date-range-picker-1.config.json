      "defaultValue": "{}",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "readonly",
      "description": "是否只读",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "elevation",
      "description": "海拔高度",
      "type": "number | boolean",
      "defaultValue": "false",
      "kind": "json",
      "initial": "false"
