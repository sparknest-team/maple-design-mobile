{
  "name": "@maplejs/maple-import-resolver",
  "version": "1.0.3",
  "description": "maple import resolver for unplugin-vue-components and unplugin-auto-import",
  "keywords": [
    "maple",
    "resolver",
    "import",
    "unplugin-vue-components",
    "unplugin-auto-import"
  ],
  "bugs": {
    "url": "https://xxx/pe.frontend/materials/maplejs/maple-design-mobile/-/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://xxx/pe.frontend/materials/maplejs/maple-design-mobile"
  },
  "license": "MIT",
  "author": "shuai.meng",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "types": "./lib/index.d.ts"
    },
    "./*": "./*"
  },
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --out-dir=lib --dts --clean",
    "dev": "tsup src/index.ts --format esm --out-dir=lib --watch --dts"
  },
  "dependencies": {
    "@maplejs/maple-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}