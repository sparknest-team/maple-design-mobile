{
  "name": "maple-library-template-vue",
  "version": "0.0.0",
  "description": "A components library example",
  "main": "lib/index.js",
  "module": "es/index.mjs",
  "typings": "types-generated/index.d.ts",
  "web-types": "highlight/web-types.en-US.json",
  "keywords": [
    "Vue",
    "UI"
  ],
  "license": "MIT",
  "sideEffects": [
    "es/**/style/*",
    "lib/**/style/*",
    "*.css",
    "*.less"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "dev": "vuepress dev docs",
    "build": "vuepress build docs --dest site",
    "preview": "maple-cli preview",
    "compile": "maple-cli compile",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "changelog": "maple-cli changelog",
    "release": "pnpm compile && maple-cli release",
    "test": "maple-cli test",
    "test:watch": "maple-cli test -w",
    "test:coverage": "maple-cli test --coverage",
    "create": "maple-cli create"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@maple-design/cli-vue": "workspace:*",
    "@maple-design/icons-vue": "workspace:*",
    "@maple-design/touch-emulator-vue": "workspace:*",
    "@maple-design/ui-vue": "workspace:*",
    "@vue/test-utils": "2.6.0",
    "@vue/runtime-core": "3.5.46",
    "@vitest/coverage-istanbul": "5.1.2",
    "@configurajs/prettier": "*",
    "jsdom": "31.0.1",
    "vitest": "5.1.2",
    "clipboard": "^2.0.11",
    "eslint": "^10.15.0",
    "lint-staged": "^17.6.2",
    "live-server": "^1.2.2",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "7.1.0-beta",
    "vue": "3.5.46",
    "vue-router": "5.5.1",
    "@vue/content-mapper": "4.0.0-alpha.0",
    "vuepress": "2.0.0-rc.32",
    "@vuepress/bundler-vite": "2.0.0-rc.32",
    "vuepress-theme-hope": "2.0.0-rc.111",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@sparknest/vuepress-plugins-vue": "^1.0.0",
    "sass-embedded": "^1.108.2",
    "less": "^4.9.1",
    "@eslint/js": "^10.0.1",
    "eslint-plugin-vue": "^10.12.1",
    "@typescript-eslint/parser": "^8.74.0",
    "vue-eslint-parser": "^10.4.2",
    "globals": "^17.14.0",
    "vite": "8.3.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,vue,less}": "prettier --write",
    "*.{ts,tsx,js,vue}": "eslint --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --allow-empty --concurrent false",
    "commit-msg": "pnpm exec maple-cli commit-lint -p $1"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "pnpm": ">=9.0",
    "node": "^22.22.0 || >=24.11.0"
  },
  "dependencies": {
    "@maple-design/shared-vue": "workspace:*"
  },
  "style": "es/library.css",
  "exports": {
    ".": {
      "types": "./types-generated/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.js"
    },
    "./style": "./es/library.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./types-generated/*/index.d.ts",
      "import": "./es/*/index.mjs",
      "require": "./lib/*/index.js"
    },
    "./*/style": {
      "import": "./es/*/style/index.mjs",
      "require": "./lib/*/style/index.js"
    }
  }
}
