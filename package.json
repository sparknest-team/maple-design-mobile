{
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install && node scripts/bootstrap.mjs",
    "build": "pnpm build:lib && pnpm build:doc",
    "build:doc": "pnpm --filter @maplejs/maple-vite-plugins build && pnpm --filter @maplejs/maple-cli exec tsc && pnpm --dir ./packages/maple-ui build:doc",
    "docs:check": "node scripts/quality/demo-sfc-check.mjs",
    "check:doc-pipeline": "node --test scripts/quality/site-resolver.test.mjs scripts/quality/markdown-demo-syntax.test.mjs scripts/quality/demo-language-route.test.mjs",
    "build:lib": "node scripts/build-lib.mjs",
    "build:play": "pnpm --dir ./packages/maple-ui-playground build",
    "changelog": "maple-cli changelog",
    "changeset": "changeset",
    "clean": "rimraf ./node_modules ./packages/*/node_modules",
    "compile:style-vars": "pnpm --dir ./packages/maple-ui compile:style-vars",
    "create": "pnpm --dir ./packages/maple-ui run create",
    "dev": "pnpm --dir ./packages/maple-ui dev",
    "dev:play": "pnpm --dir ./packages/maple-ui-playground dev",
    "format": "prettier --write .",
    "format:cache": "prettier --write --cache .",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "lint": "eslint --fix .",
    "lint:cache": "eslint --fix --cache .",
    "lint:check": "eslint . --max-warnings 0",
    "package:check": "node scripts/quality/package-check.mjs",
    "preview": "pnpm --dir ./packages/maple-ui preview",
    "preview:play": "pnpm --dir ./packages/maple-ui-playground preview",
    "quality": "pnpm spec:check && pnpm check:style-vars && pnpm check:dev-boundary && pnpm check:cross-platform && pnpm lint:check && pnpm typecheck && pnpm check:test-collection && pnpm test && pnpm check:cli && pnpm check:source-normalization && pnpm check:icon-bundle && pnpm check:component-bundle && pnpm build && pnpm package:check",
    "release": "node scripts/release.mjs",
    "release:extension": "pnpm --dir ./packages/maple-vscode-extension release",
    "spec:check": "node scripts/quality/spec-check.mjs",
    "test": "pnpm --dir ./packages/maple-ui test",
    "test:coverage": "pnpm --dir ./packages/maple-ui test:coverage",
    "test:watch": "pnpm --dir ./packages/maple-ui test:watch",
    "typecheck": "pnpm --dir ./packages/maple-ui exec vue-tsc --noEmit -p tsconfig.json",
    "version-packages": "changeset version",
    "check:tabs": "node checks/tabs-same-source.mjs",
    "check:rate": "node checks/rate-same-source.mjs",
    "check:ripple": "node checks/ripple-same-source.mjs",
    "check:lightweight-feedback": "node checks/lightweight-feedback-same-source.mjs",
    "check:input": "node checks/input-same-source.mjs",
    "check:selection-field": "node checks/selection-field-same-source.mjs",
    "check:selection-presentations": "node checks/selection-presentations-same-source.mjs",
    "check:auto-complete": "node checks/auto-complete-same-source.mjs",
    "check:time-rules": "node checks/time-rules-same-source.mjs",
    "check:form-kernel": "node checks/form-kernel-same-source.mjs",
    "check:style-vars": "node checks/style-vars-contract.mjs",
    "check:date-family": "node checks/date-family-same-source.mjs",
    "check:scroll-text": "node checks/scroll-text-same-source.mjs",
    "check:dev-boundary": "node --test scripts/quality/dev-publish-boundary.test.mjs",
    "check:cli": "pnpm --dir packages/maple-cli test",
    "check:source-normalization": "node --test scripts/quality/source-normalization.test.mjs",
    "check:test-collection": "node --test scripts/quality/test-collection-boundary.test.mjs",
    "check:cross-platform": "pnpm check:tabs && pnpm check:rate && pnpm check:ripple && pnpm check:lightweight-feedback && pnpm check:input && pnpm check:selection-field && pnpm check:selection-presentations && pnpm check:auto-complete && pnpm check:time-rules && pnpm check:form-kernel && pnpm check:date-family && pnpm check:scroll-text",
    "check:icon-bundle": "node --test scripts/quality/icon-bundle.test.mjs",
    "check:component-bundle": "node scripts/quality/component-bundle.cjs && node --test scripts/quality/shared-bundle.test.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged --allow-empty",
    "commit-msg": "pnpm exec maple-cli commit-lint -p $1 && pnpm exec maple-cli checklist $1"
  },
  "nano-staged": {
    "*.{ts,tsx,js,vue,less}": "prettier --write",
    "*.{ts,tsx,js,vue}": "eslint --fix"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@configurajs/eslint": "^0.1.2",
    "@configurajs/prettier": "^0.1.4",
    "@maplejs/icons-vue": "workspace:*",
    "@maplejs/maple-cli": "workspace:*",
    "@ui-foundation/theme-contract": "link:../design-ui/packages/theme-contract",
    "@vue/server-renderer": "catalog:",
    "axe-core": "^4.10.3",
    "eslint": "^9.32.0",
    "nano-staged": "0.8.0",
    "nanospinner": "^1.2.2",
    "prettier": "^3.6.2",
    "rimraf": "catalog:",
    "simple-git-hooks": "^2.13.1",
    "tinyexec": "npm:tinyexec@^0.3.0",
    "typescript": "catalog:",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "pnpm": ">=9.6.0"
  },
  "pnpm": {
    "overrides": {
      "array-includes": "npm:@nolyfill/array-includes@latest",
      "array.prototype.flat": "npm:@nolyfill/array.prototype.flat@latest",
      "array.prototype.flatmap": "npm:@nolyfill/array.prototype.flatmap@latest",
      "object.assign": "npm:@nolyfill/object.assign@latest",
      "object.entries": "npm:@nolyfill/object.entries@latest",
      "object.values": "npm:@nolyfill/object.values@latest",
      "tinyexec": "npm:tinyexec@^0.3.0"
    }
  }
}
